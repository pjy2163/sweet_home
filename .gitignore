# Large or generated processed data
data/processed/*.parquet
data/processed/*.xlsx

# Keep small CSV schemas/results only when intentionally reviewed.
# If a processed CSV becomes large or sensitive, move it to data/raw or add it here explicitly.

# Exports are generated report outputs
data/exports/**
!data/exports/
!data/exports/.gitkeep

