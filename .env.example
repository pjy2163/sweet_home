# Backend server-only configuration. Never expose these values as NEXT_PUBLIC_*.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Production PostgreSQL URLs must include sslmode=require or verify-full.
DATABASE_URL=
SWEETHOME_REQUIRE_DATABASE_TLS=false
SWEETHOME_AI_REPORT_ENABLED=false
SWEETHOME_REQUIRE_INTERNAL_PROXY=false
SWEETHOME_INTERNAL_API_KEY=
SWEETHOME_MAX_SAVED_REPORTS_PER_USER=50

# Next.js server proxy and browser-safe Kakao JavaScript key.
SWEETHOME_API_BASE_URL=http://127.0.0.1:8000
# Browser-visible by design. Restrict allowed web domains in Kakao Developers.
NEXT_PUBLIC_KAKAO_MAP_APP_KEY=
SWEETHOME_DEV_AUTH_SUBJECT=
# Enable only after Azure Easy Auth is configured on the public frontend app.
SWEETHOME_TRUST_AZURE_IDENTITY_HEADERS=false

# Copy backend values to a local root .env and frontend values to
# frontend/.env.local as needed. Never commit either local file.
