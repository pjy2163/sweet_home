# Copy this file to .env.local in frontend/.
# Never commit real secrets.

# Browser-visible by design. Restrict allowed web domains in Kakao Developers.
NEXT_PUBLIC_KAKAO_MAP_APP_KEY=
SWEETHOME_API_BASE_URL=http://127.0.0.1:8000
SWEETHOME_INTERNAL_API_KEY=
# Enable only after Azure Easy Auth is configured on the public frontend app.
SWEETHOME_TRUST_AZURE_IDENTITY_HEADERS=false
# Optional local-only opaque subject. Never use this setting in Azure.
SWEETHOME_DEV_AUTH_SUBJECT=
