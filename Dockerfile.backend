FROM python:3.12-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PORT=8000

WORKDIR /app

RUN groupadd --system sweethome \
    && useradd --system --gid sweethome --home-dir /app sweethome

COPY requirements.txt ./
RUN python -m pip install --upgrade pip \
    && python -m pip install --requirement requirements.txt

COPY src ./src
COPY data/processed/region_comparison_snapshot.csv ./data/processed/region_comparison_snapshot.csv
COPY data/processed/region_geometry.csv ./data/processed/region_geometry.csv
COPY data/processed/housing_rent_snapshot.csv ./data/processed/housing_rent_snapshot.csv

USER sweethome

EXPOSE 8000

CMD ["sh", "-c", "uvicorn src.api.main:app --host 0.0.0.0 --port ${PORT}"]
